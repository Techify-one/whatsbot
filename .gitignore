# Dados sensíveis / sessão WhatsApp / banco de dados
storages/
statics/

# Logs
logs/

# Ambiente virtual
venv/

# Python cache
__pycache__/
*.pyc
*.pyo

# Variáveis de ambiente
.env
.env.*

# Build artifacts
dist/
build/
*.exe
!bin/gowa.exe

# Plugins exportados (.zip distribuído pela Loja, não versionado no core)
*-plugin.zip

# Linux GOWA binary (baixado/buildado localmente por dev; não trackeado)
bin/gowa
# Stamp da versão do GOWA em bin/ (escrito em runtime pelos launchers e pelo
# Dockerfile). Trackear isso criaria uma fonte de verdade conflitante entre
# máquinas. A fonte única é o arquivo GOWA_VERSION.
bin/.gowa_stamp

# Docker persistent data
data/

# Plugin restart trigger (touched by plugins.restart at runtime)
server/_reload_trigger.py
.reload_sentinel

# Planos de implementação (local, não versionado)
PLANO_setup_wizard.md
